# Multi-stage build for Gradio (minimal size)
FROM python:3.12-slim as builder

WORKDIR /build

COPY requirements-gradio.txt ./
RUN pip install --user --no-cache-dir -r requirements-gradio.txt

# Production stage
FROM python:3.12-slim

WORKDIR /src

# Minimal system dependencies (no OpenGL/CV libs needed)
RUN apt-get update \
  && apt-get clean \
  && rm -rf /var/lib/apt/lists/*

# Copy Python packages from builder
COPY --from=builder /root/.local /root/.local

# Copy application code
COPY . /src/

ENV PATH=/root/.local/bin:$PATH
ENV GRADIO_SERVER_NAME="0.0.0.0"
ENV GRADIO_SERVER_PORT="7866"
ENV API_BASE_URL="http://ai-data-processing:8888"

EXPOSE 7866

# CMD ["python", "ui/app.py"]
